# shrek environment -- cp .env.example .env and fill in.
# Same variables work for the CLI (export or $SHREK_HOME/.env) and the bot.

# --- smart brain (BYOK; everything picks these up) ------------------------
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Default currency for amounts written without one (chosen on first run).
SHREK_DEFAULT_CURRENCY=INR

# --- telegram bot (only needed for shrek-bot) ------------------------------
# Your personal instance is locked to you: only this Telegram numeric ID is served.
SHREK_OWNER_ID=123456789
# From @BotFather
TELEGRAM_BOT_TOKEN=000000000:AAAA-your-botfather-token
# Where the bot's SQLite ledger stays (keep under /data inside Docker)
SHREK_DB_PATH=/data/ledger.db
