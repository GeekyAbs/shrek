# shrek-bot environment — copy to .env and fill in
# Your personal instance is locked to you: only this Telegram numeric ID is served.
# Get your ID from @userinfobot (or any id bot).
SHREK_OWNER_ID=123456789
# From @BotFather when you create your bot
TELEGRAM_BOT_TOKEN=000000000:AAAA-your-botfather-token
# Where the bot's SQLite ledger lives (keep under /data inside Docker)
SHREK_DB_PATH=/data/ledger.db
